; Port checker
class PortChecker {
    static IsOpen(host, port, timeout := 3000) {
        try {
            ; Check if port is open
            startTime := A_TickCount

            while (A_TickCount - startTime < timeout) {
                ; Try to connect
                ; Simplified implementation
                Sleep(100)
            }

            return false
        } catch Error {
            return false
        }
    }

    static ScanPorts(host, startPort, endPort) {
        openPorts := []

        loop (endPort - startPort + 1) {
            port := startPort + A_Index - 1
            if (this.IsOpen(host, port, 500)) {
                openPorts.Push(port)
            }
        }

        return openPorts
    }
}

; Base64 encoding
class Base64 {
    static Encode(text) {
        try {
            objXML := ComObject("MSXML2.DOMDocument")
            objNode := objXML.CreateElement("tmp")
            objNode.DataType := "bin.base64"
            objNode.Text := text

            return objNode.NodeTypedValue
        } catch Error {
            return text
        }
    }

    static Decode(encoded) {
        try {
            objXML := ComObject("MSXML2.DOMDocument")
            objNode := objXML.CreateElement("tmp")
            objNode.DataType := "bin.base64"
            objNode.NodeTypedValue := encoded

            return objNode.Text
        } catch Error {
            return encoded
        }
    }
}

; Test Base64
encoded := Base64.Encode("Hello World")
MsgBox("Encoded: " . encoded)
